# 运行环境：development / staging / production
APP_ENV=development

# 日志级别：DEBUG / INFO / WARNING / ERROR
APP_LOG_LEVEL=INFO
# 日志目录：按小时轮转，app.log 全部级别，error.log 仅 ERROR
APP_LOG_DIR=./logs

# 数据库连接串（当前笔记生成无需启动数据库；默认 SQLite，便于本地入门）
# 需要 MySQL/OceanBase 时再改为 mysql+aiomysql://user:pass@host:port/db
APP_DATABASE_URL=sqlite+aiosqlite:///./app.db

# Redis 地址（队列/缓存，可选）
APP_REDIS_URL=redis://localhost:6379/0

# 上游 LLM 服务密钥（调用外部模型时必填）
APP_LLM_API_KEY=

# LLM Provider：当前默认 aliyun（阿里云通义千问）；代码仅实现 aliyun
APP_LLM_PROVIDER=aliyun
# 阿里云通义千问：模型名（如 qwen-plus、qwen-turbo）、地域、超时、重试次数
APP_LLM_MODEL=qwen-plus
APP_LLM_IMAGE_MODEL=qwen3-vl-plus
APP_LLM_REGION=cn
APP_LLM_TIMEOUT=120
APP_LLM_RETRY_COUNT=3
# 仅完整 /report 链路：每个生成子进程最多同时请求的模型数
# 快速 /generate 每次仅一个模型请求，服务默认最多同时处理两次生成
APP_LLM_MAX_CONCURRENCY=3

# 签名/会话密钥（生产必填，仅通过环境变量注入）
APP_SECRET_KEY=<your-secret-key>

# API 鉴权：合法 API Key 列表，逗号分隔；本地开发可留空，生产须设置自己的值
# Flutter 中的 API Key 填这里的其中一个值，不要填上面的 APP_LLM_API_KEY
APP_API_KEYS=

# 百度千帆搜索（AppBuilder）：仅使用搜索工具时配置；笔记生成无需填写
APP_BAIDU_API_KEY=
APP_BAIDU_SEARCH_TIMEOUT=30

# 目录读取工具：若设置则仅允许列出该根目录下的路径（防目录穿越），空表示不限制
# APP_TOOLS_DIRECTORY_READ_ROOT=./data/files

# AI 应用输出数据目录（每次运行在其下创建子目录，如小红书笔记临时图片等）
APP_DATA_OUTPUT_DIR=./data/output

# 小红书笔记：多模态调用前图片统一压缩（长边最大像素，0 表示不缩放；质量 1–100）
APP_XHS_IMAGE_MAX_SIZE=1024
APP_XHS_IMAGE_QUALITY=85
APP_XHS_MAX_IMAGES=20
APP_XHS_MAX_IMAGE_BYTES=10485760
APP_XHS_MAX_TOTAL_BYTES=52428800
APP_XHS_MAX_IMAGE_PIXELS=40000000
APP_XHS_MAX_CONCURRENT_GENERATIONS=2
# 包括图片处理及全部Crew阶段的总硬超时；超时会终止生成子进程
APP_XHS_GENERATION_TIMEOUT=600
APP_CREW_EXECUTION_TIMEOUT=600
# 首次入门可改成 true：无需模型密钥、不调用模型；响应 is_demo=true，内容带“演示”标记
# 真实创作须改回 false、填写 APP_LLM_API_KEY 并重启服务；生产环境禁止演示模式
APP_XHS_DEMO_MODE=false
# 禁止遥测与服务端交互式提示
CREWAI_TELEMETRY_DISABLED=true
OTEL_SDK_DISABLED=true
CREWAI_TESTING=true
# CrewAI：服务端无 TTY 时建议设 true，关闭 "Would you like to view your execution traces?" 等交互提示（代码中 deep_research 流程已自动设置）
# CREWAI_TESTING=true

# 应用服务端口
APP_PORT=8072
