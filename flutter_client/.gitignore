*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Machine-local SDKs, environment files and credentials. Keep safe templates.
/.tooling/
/.fvm/flutter_sdk
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
/secrets/
/credentials/
*.secrets.json
*.credentials.json
dart_defines.json
dart_defines.*.json
dart-defines.json
dart-defines.*.json
!dart_defines.example.json
!dart-defines.example.json

# Service configuration generated for a private account, not app source.
google-services.json
GoogleService-Info.plist
firebase_options.dart

# Signing material must be supplied locally, never published with the source.
*.jks
*.keystore
*.p12
*.pfx
*.p8
*.key
*.pem
*.mobileprovision
*.provisionprofile

# Local test captures and copied gallery/share images. Do not ignore app assets.
/artifacts/
/screenshots/
/recordings/
/cache/
/tmp/
/temp/
/private_photos/
share_images/
note_share_images/
photo_cache/
image_picker_cache/
